---
// 在 Starlight 默认页脚（翻页与页面工具）之后追加全站语言声明，
// 使每种语言、每一页都能看到维护基准与译本关系。
import Footer from '@astrojs/starlight/components/Footer.astro';
import { languageNotices } from '../../lib/language-notice.mjs';

const { lang } = Astro.locals.starlightRoute;
const notice = languageNotices[lang] || languageNotices.en;
---

<Footer />
<p class="language-notice">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
  </svg>
  <span>{notice}</span>
</p>

<style>
  .language-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 1.5rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .language-notice svg {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    margin-top: 0.12rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media print {
    .language-notice { display: none; }
  }
</style>
