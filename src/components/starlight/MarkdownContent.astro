---
import MarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
import { readingLabels } from '../../lib/reading-labels.mjs';

const labels = readingLabels[Astro.locals.starlightRoute.lang] || readingLabels.en;
---

<sonic-reading-media>
  <MarkdownContent><slot /></MarkdownContent>
  <dialog class="figure-dialog" aria-label={labels.figure} aria-describedby="figure-viewer-hint">
    <header class="figure-dialog-header">
      <p id="figure-viewer-hint">{labels.scroll}</p>
      <form method="dialog"><button type="submit" autofocus>{labels.close} <span aria-hidden="true">×</span></button></form>
    </header>
    <div class="figure-dialog-scroll" tabindex="0" aria-label={labels.figure}>
      <img class="figure-dialog-image" alt="" />
    </div>
    <p class="figure-dialog-caption"></p>
  </dialog>
</sonic-reading-media>

<script>
  class SonicReadingMedia extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
      const image = dialog.querySelector<HTMLImageElement>('img')!;
      const caption = dialog.querySelector<HTMLElement>('.figure-dialog-caption')!;
      let opener: HTMLAnchorElement | undefined;
      const themeIsDark = () => document.documentElement.dataset.theme === 'dark';
      const sourceFor = (link: HTMLAnchorElement) =>
        link.querySelector<HTMLImageElement>(themeIsDark() ? '.doc-figure-img--dark' : '.doc-figure-img--light')
        || link.querySelector<HTMLImageElement>('img');
      const showFigure = (link: HTMLAnchorElement) => {
        const source = sourceFor(link);
        if (!source) return false;
        image.src = source.src || link.href;
        image.alt = source.alt;
        image.width = Number(source.getAttribute('width'));
        image.height = Number(source.getAttribute('height'));
        caption.textContent = source.alt;
        return true;
      };
      this.addEventListener('click', (event) => {
        if (!(event.target instanceof Element) || !(event instanceof MouseEvent)) return;
        const link = event.target.closest<HTMLAnchorElement>('a[data-doc-image]');
        if (!link || !this.contains(link) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (typeof dialog.showModal !== 'function' || !showFigure(link)) return;
        event.preventDefault();
        opener = link;
        dialog.showModal();
        dialog.querySelector('.figure-dialog-scroll')?.scrollTo(0, 0);
      });
      // 主题切换时同步对话框中的原图版本。
      new MutationObserver(() => {
        if (dialog.open && opener) showFigure(opener);
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));
    }
  }
  if (!customElements.get('sonic-reading-media')) customElements.define('sonic-reading-media', SonicReadingMedia);
</script>

<style>
  sonic-reading-media { display: block; }
  .figure-dialog { width: min(94vw, 92rem); max-width: 94vw; max-height: 92vh; margin: auto; padding: 0; color: var(--sl-color-white); background: var(--sl-color-bg); border: 1px solid var(--sl-color-hairline); border-radius: 1rem; box-shadow: var(--sl-shadow-lg); }
  .figure-dialog::backdrop { background: rgb(2 6 23 / 75%); }
  .figure-dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1rem; border-bottom: 1px solid var(--sl-color-hairline); }
  .figure-dialog-header p { margin: 0; color: var(--sl-color-gray-2); font-size: 0.875rem; }
  .figure-dialog-header form { flex-shrink: 0; }
  button { display: flex; align-items: center; gap: 0.7rem; min-height: 44px; padding: 0.5rem 0.8rem; color: var(--sl-color-white); background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem; cursor: pointer; }
  button span { font-size: 1.25rem; }
  .figure-dialog-scroll { max-height: 68vh; overflow: auto; overscroll-behavior: contain; }
  .figure-dialog-image { display: block; width: auto; max-width: none; height: auto; margin-inline: auto; }
  .figure-dialog-caption { margin: 0; padding: 0.85rem 1rem; border-top: 1px solid var(--sl-color-hairline); font-size: 0.875rem; line-height: 1.5; }
  @media (max-width: 30rem) { .figure-dialog-header { align-items: flex-start; gap: 0.5rem; } }
  @media print { .figure-dialog { display: none !important; } }
</style>
